{
  "name": "speed-shuffle-usa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Static leaderboard for Speed Shuffling Across the USA",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "netlify dev --offline --no-open --functions netlify/functions",
    "check": "astro check",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "dev:astro": "ASTRO_DEV_BACKGROUND=1 astro dev --port 4322",
    "test": "node --experimental-strip-types --test tests/*.test.ts"
  },
  "dependencies": {
    "astro": "7.3.2",
    "csv-parse": "^7.0.2",
    "google-auth-library": "^11.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@types/node": "^22.12.0",
    "netlify-cli": "23.13.5",
    "typescript": "5.9.3"
  }
}
