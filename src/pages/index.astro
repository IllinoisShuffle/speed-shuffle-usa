---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Winners from '../components/Winners.astro';
import HowItWorks from '../components/HowItWorks.astro';
import EntryPrizes from '../components/EntryPrizes.astro';
import ClubDirectory from '../components/ClubDirectory.astro';
import Leaderboard from '../components/Leaderboard.astro';
import Rules from '../components/Rules.astro';
import ClosingBand from '../components/ClosingBand.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
import { clubs } from '../lib/clubs';
import { tournamentConfig } from '../lib/config';

const stats = clubs.map(club => ({ clubId: club.id, registered: 0, completed: 0 }));
---
<BaseLayout>
  <Header />
  <main id="main">
    <Hero />
    {tournamentConfig.stage === 'final' && <Winners />}
    <HowItWorks />
    <EntryPrizes />
    <ClubDirectory stats={stats} />
    <Leaderboard />
    <Rules />
    <ClosingBand />
    <Contact />
  </main>
  <Footer />
  <script>import '../scripts/live-leaderboard';</script>
</BaseLayout>
