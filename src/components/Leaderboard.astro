---
import LeaderboardRow from './LeaderboardRow.astro';
import type { PlayerStanding } from '../lib/types';
interface Props { players: PlayerStanding[]; showScores: boolean; payoutPositions: number }
const { players, showScores, payoutPositions } = Astro.props;
---
<section class="panel leaderboard" aria-labelledby="leaderboard-title">
  <div class="panel-heading">
    <div><h2 id="leaderboard-title">Individual leaderboard</h2><p class="muted"><span id="player-count">{players.length}</span> players · overall rank</p></div>
    <span class="badge" id="score-status">{showScores ? 'Scores revealed' : 'Scores hidden'}</span>
    <p class="payout-note">Top {payoutPositions} are payout positions</p>
  </div>
  <table>
    <caption class="sr-only">Individual standings. Top {payoutPositions} are payout positions. {showScores ? 'Exact scores displayed.' : 'Exact scores withheld.'}</caption>
    <thead id="leaderboard-head"><tr><th scope="col" class="rank">Rank</th><th scope="col">Player</th><th scope="col">Club</th>{showScores && <th scope="col" class="score">Score</th>}</tr></thead>
    <tbody id="leaderboard-body">{players.map(player => <LeaderboardRow player={player} showScores={showScores} payoutPositions={payoutPositions} />)}</tbody>
  </table>
  <p class="table-footer">Equal totals share a rank. Final tie and payout decisions belong to the organizers.</p>
</section>
