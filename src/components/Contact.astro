---
import { tournamentContactEmail } from '../lib/config';
---
<section class="section contact" id="contact" aria-labelledby="contact-title">
  <div class="shell contact-card card">
    <div class="section-kicker">
      <span class="eyebrow">Tournament questions</span>
      <h2 id="contact-title">Speed Shuffle organizers, ILSA</h2>
    </div>
    <a class="contact-email" href={`mailto:${tournamentContactEmail}`}>{tournamentContactEmail}</a>
    <p class="contact-note">For session dates at a specific club, contact that club directly (see the directory above).</p>
  </div>
</section>
