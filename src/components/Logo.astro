---
interface Props { class?: string; size?: number }
const { class: className = '', size = 40 } = Astro.props;
---
<svg class={`ss-mark ${className}`} width={size} height={size} viewBox="0 0 180 100" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
  <line x1="22" y1="34" x2="80" y2="34" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
  <line x1="6" y1="50" x2="80" y2="50" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
  <line x1="34" y1="66" x2="80" y2="66" stroke="currentColor" stroke-width="8" stroke-linecap="round" />
  <circle cx="131" cy="50" r="40" fill="var(--accent)" />
  <circle cx="131" cy="50" r="24" fill="var(--accent-strong)" stroke="#15181A" stroke-opacity="0.22" stroke-width="2" />
  <circle cx="131" cy="50" r="6.8" fill="#F7D45A" stroke="#15181A" stroke-opacity="0.18" stroke-width="1.2" />
  <g class="ss-spin">
    <circle cx="153.63" cy="72.63" r="4.4" fill="var(--accent-strong)" stroke="#15181A" stroke-opacity="0.22" stroke-width="1" />
    <circle cx="108.37" cy="72.63" r="4.4" fill="var(--accent-strong)" stroke="#15181A" stroke-opacity="0.22" stroke-width="1" />
    <circle cx="108.37" cy="27.37" r="4.4" fill="var(--accent-strong)" stroke="#15181A" stroke-opacity="0.22" stroke-width="1" />
    <circle cx="153.63" cy="27.37" r="4.4" fill="var(--accent-strong)" stroke="#15181A" stroke-opacity="0.22" stroke-width="1" />
  </g>
</svg>
