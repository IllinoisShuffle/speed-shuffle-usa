# Copy to .env. This file is configuration guidance, not credentials.
# Paste a Google Sheets link or just its spreadsheet ID here.
SHEETS_SPREADSHEET_ID=
SHEETS_RANGE="Players!A1:Z"
# private (default) uses Google credentials. public reads a link-accessible TEST sheet.
SHEETS_ACCESS=private
# The tab ID after gid= in a sheet URL; used only in public mode.
SHEETS_GID=0

# Local option: absolute path to your Google service-account JSON key.
# Keep the key outside the repository. Never paste it into chat.
GOOGLE_APPLICATION_CREDENTIALS=

# Netlify option: set these server-side variables instead of a key-file path.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
